{
  "name": "privacy-for-elysium",
  "private": true,
  "type": "module",
  "workspaces": [
    "projects/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -p projects/eloscape --noEmit",
    "test:fork": "NODE_USE_ENV_PROXY=1 tsx test/eloscape.fork.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "license": "MIT"
}
